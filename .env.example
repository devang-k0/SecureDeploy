# SecureDeploy Configuration
# Copy this file to .env and customize as needed.
# All variables are prefixed with SECUREDEPLOY_

# --- Ollama (optional AI triage) ---
SECUREDEPLOY_OLLAMA_URL=http://localhost:11434
SECUREDEPLOY_OLLAMA_MODEL=mistral
SECUREDEPLOY_OLLAMA_TIMEOUT=120

# --- Scan Limits ---
SECUREDEPLOY_MAX_REPO_SIZE_MB=500
SECUREDEPLOY_SCAN_TIMEOUT_SECONDS=600
SECUREDEPLOY_MAX_UPLOAD_SIZE_MB=200

# --- Server ---
SECUREDEPLOY_APP_HOST=0.0.0.0
SECUREDEPLOY_APP_PORT=8000
